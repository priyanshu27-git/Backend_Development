<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 p-10 text-white">
        <div class="flex justify-end">
            <a class="px-3 py-2 bg-red-500 rounded-md hover:bg-red-700" href="/logout">logout</a>
        </div>
        <h5 class="text-3xl mb-5">Upload your file</h5>
        <form autocomplete="off" action="/upload" method="post" enctype="multipart/form-data">
            <input class="bg-zinc-800 p-2 cursor-pointer" type="file" name="image" >
            <input class="px-5 py-2 bg-green-600 hover:scale-102 rounded-md" type="submit" value="Upload File">
        </form>
    </div>
</body>
</html>
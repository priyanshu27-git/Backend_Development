<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 p-10 text-white">
        <div class="flex justify-end">
            <a class="px-3 py-2 bg-red-500 rounded-md hover:bg-red-700" href="/logout">logout</a>
        </div>
        <h5 class="mb-5">Edit your post</h5>
        <form action="/update/<%= post._id%>" method="post">
            <textarea placeholder="what's on your mind " class="p-4 w-1/4 resize-none outline-none bg-transparent border-2 border-zinc-800 rounded-md block mb-2" name="content"><%= post.content %></textarea>
            <input class="w-40 px-3 py-2 bg-yellow-500 text-black rounded-md hover:scale-102 block" type="submit" value="Update post">
        </form>
    </div>
</body>
</html>
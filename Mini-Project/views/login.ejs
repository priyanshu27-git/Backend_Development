<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 p-10 text-white">
        <h1 class="text-3xl font-semibold mb-4">Login Your Account</h1>
        <form action="/login" method="post">
            <input class="px-3 py-2 rounded-md border-2 outline-none bg-zinc-800 bg-transparent " type="email" placeholder="email" name="email">
            <input class="px-3 py-2 rounded-md border-2 outline-none bg-zinc-800 bg-transparent " type="password" placeholder="password" name="password">
            <input class="px-5 py-2 bg-blue-500 hover:scale-102 rounded-md" type="submit" value="Login Account">
        </form>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 p-10 text-white">
        <div class="flex justify-end">
            <a class="px-3 py-2 bg-red-500 rounded-md hover:bg-red-700" href="/logout">logout</a>
        </div>
        <h1 class="text-3xl font-semibold">Hello ,  <%= user.name %> </h1>
        <h5 class="mb-5">you can create a new post</h5>
        <form action="/post" method="post">
         <textarea placeholder="what's on your mind " class="p-4 w-1/4 resize-none outline-none bg-transparent border-2 border-zinc-800 rounded-md block mb-2" name="content"></textarea>
         <input class="w-40 px-3 py-2 bg-blue-500 rounded-md hover:scale-102 block" type="submit" value="Create a new post">
        </form>

        <div class="posts mt-20">
            <h3 class="text-zinc-400 ">Your Posts</h3>
            <div class="postContainer mt-4">
                <% user.posts.reverse().forEach(function (post) { %>
                  <div class="post w-1/3 mb-4 border-2 border-zinc-700 bg-zinc-800 p-3 rounded-md">
                    <h3 class="text-blue-500 text-lg mb-2"><%= user.username %> </h3>
                    <p class="text-sm tracking-tight"> <%= post.content %></p>
                    <small class="mt-2 inline-block"><%= post.likes.length %> likes</small>
                    <div class="flex gap-4 mt-1">
                        <a class="btn text-blue-500 hover:text-blue-700" href="/like/<%= post._id%> "> <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike"%> </a>
                        <a class="text-zinc-400 hover:text-zinc-200" href="/edit/<%= post._id%>">Edit</a>
                    </div>
                </div>      
              <% }) %>
            </div>
        </div>
    </div>
</body>
</html>
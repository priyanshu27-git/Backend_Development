<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="main bg-zinc-900 min-h-screen w-full">
        <div class="form text-white p-10 w-1/2">
           <form action="/create" method="post">
                 <input class="block px-5 py-2 w-full rounded-md outline-none bg-zinc-800"  type="text" placeholder="Enter Title Here" name = "title">
                 <textarea class=" block px-5 py-2 w-full mt-2 rounded-md resize-none outline-none bg-zinc-800" placeholder="Enter details Here" name = "details"></textarea>
                 <input class="mt-2 px-5 py-2 bg-cyan-800 rounded active:scale-105"  type="submit" value="Create Task">
           </form>
        </div>

        <div class="tasks p-10 flex gap-4 flex-wrap">
            <%  if(files.length === 0){ %>
                <h3 class="text-zinc-600 text-bold text-2xl">No task yet</h3>
                <% } else  { %>
                    <%  files.forEach(function (val){ %>
                    <div class="task w-fit px-3 py-5 bg-zinc-800 rounded-md">
                      <h1 class="text-white text-3xl"><%= val%></h1>
                        <div class="flex gap-3 justify-between mt-3">
                            <a  class="text-blue-400 inline-block text-md" href="/file/<%= val %>">Read More..</a>
                            <a class="text-gray-500 hover:bg-gray-700" href="/edit/<%= val%>">Edit </a>
                        </div>
                    </div>
                  <%  }) %>
                 <%  } %>
        </div>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white ">
        <a class="text-blue-500 mb-10 inline-block" href="/">Go Back to Home</a>
        <form action="/edit" method="post">
                <input  class="block px-5 py-2 w-full text-zinc-600 rounded-md outline-none bg-zinc-800"  type="text" placeholder="Previous Name" name="Previous" value="<%= Previous %>">
                <textarea class=" block px-5 py-2 w-full mt-2 rounded-md resize-none outline-none bg-zinc-800" placeholder="New Name" name="New"></textarea>
                <input class="mt-2 px-5 py-2 bg-orange-500 rounded  active:scale-105" type="submit"  value="Update Name">
            </form>
    </div>
</body>
</html>
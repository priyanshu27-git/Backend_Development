<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="h-full w-full bg-zinc-900 p-10 text-white ">
        <a class="tetx-lg text-blue-500 hover:text-xl" href="/">Back to Home</a>
        <h1 class="text-3xl tracking-tighter mt-3 mb-5">Create User</h1>
        <div class="users flex gap-4 flex-wrap ">
            <% if(users.length < 1){ %>
                <h3 class="text-xl text-zinc-600">No users Found</h3>
           <% } else { %>
            <% users.forEach(function (user)  { %>
                <div class="user w-70 p-4 bg-zinc-800 rounded-lg">
                <div class="w-full h-70 bg-zinc-500 rounded-lg "> 
                    <img class="h-full w-full object-cover object-left overflow-hidden" src="<%= user.image%>" alt="">
                </div>
                    <h3 class="text-xl text-white mt-2"><%= user.name%> </h3>
                    <h5 class="text-gray-500"><%= user.email%></h5>
                    <div class="flex gap-4 mt-10">
                        <a class="text-white text-lg font-medium" href="/edit/<%= user._id%>">Edit User</a>
                        <a class="text-red-500 text-lg font-medium" href="/delete/<%= user._id%>">Delete User</a>
                    </div>
                </div>
            <% }) %>
            <% } %>
            
        </div>
    </div>
</body>
</html>
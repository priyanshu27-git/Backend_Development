<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="p-10 w-full h-screen bg-zinc-900 text-white">
        <h1 class="text-3xl font-semibold mb-3">Login User</h1>
        <form  action="/login" method="post">
            <input class="px-3 py-2 rounded-lg bg-transparent bg-zinc-800 outline-none" type="email" placeholder="email" name="email">
            <input class="px-3 py-2 rounded-lg bg-transparent bg-zinc-800 outline-none" type="password" placeholder="password" name="password">
            <input class="px-6 py-2 bg-blue-600 rounded-md hover:scale-102 cursor-pointer"  type="submit" value="Login User">
        </form>
    </div>
</body>
</html>